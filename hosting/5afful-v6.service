# systemd service for a VPS. Change YOUR_USER and the folder, then:
#   sudo cp hosting/5afful-v6.service /etc/systemd/system/5afful-v6.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now 5afful-v6
#   journalctl -u 5afful-v6 -f        (the bot's log)
[Unit]
Description=5AFFUL V6 WhatsApp bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/5afful-v6
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
